<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 3 按钮样式 -->
    
    <!-- Filled Button - 主要操作按钮 -->
    <style name="Widget.MusicPlayer.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_md3_filled</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Outlined Button - 次要操作按钮 -->
    <style name="Widget.MusicPlayer.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/btn_md3_outlined</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Outlined Button - 次要操作按钮 (别名) -->
    <style name="Widget.MusicPlayer.Button.OutlinedButton" parent="Widget.MusicPlayer.Button.Outlined" />

    <!-- Tonal Button - 中等重要性按钮 -->
    <style name="Widget.MusicPlayer.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:background">@drawable/btn_md3_tonal</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Tonal Button - 中等重要性按钮 (别名) -->
    <style name="Widget.MusicPlayer.Button.TonalButton" parent="Widget.MusicPlayer.Button.Tonal" />

    <!-- Elevated Button - 带阴影的按钮 -->
    <style name="Widget.MusicPlayer.Button.ElevatedButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:background">@drawable/btn_md3_elevated</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Text Button - 文本按钮 -->
    <style name="Widget.MusicPlayer.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- Icon Button - 图标按钮 -->
    <style name="Widget.MusicPlayer.Button.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">24dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Filled Icon Button - 填充图标按钮 -->
    <style name="Widget.MusicPlayer.Button.IconButton.Filled" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:tint">?attr/colorOnPrimaryContainer</item>
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
        <item name="iconSize">24dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- FAB - Floating Action Button -->
    <style name="Widget.MusicPlayer.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
        <item name="fabSize">mini</item>
    </style>

    <!-- Large FAB -->
    <style name="Widget.MusicPlayer.FloatingActionButton.Large" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
        <item name="fabSize">normal</item>
    </style>
</resources>
